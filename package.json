{
  "name": "agarai",
  "version": "0.2.0",
  "description": "Trobotni agar.rs teaming simulator - vodi tri taba kao tri igraca koji jedan drugom dodaju masu i grade sliku okruzenja.",
  "type": "module",
  "bin": {
    "agarai": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "capture": "node src/index.js --capture --no-team",
    "test": "node --test test/unit.test.mjs",
    "sim": "node test/sim/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  }
}
